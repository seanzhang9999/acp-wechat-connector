# Stage A only. Copy outside the repository; mode 0600. No credentials here.
AGY_BIN=/REPLACE/WITH/VERIFIED/agy
AGY_PROBE_CWD=/var/lib/awei-antigravity/probe-workspace
AGY_PROBE_TIMEOUT_MS=90000
# Leave blank for discovery; set an EXACT model ID returned by discovery for one call.
AGY_MODEL_ID=
# Only if the provider has no semantic model category or multiple model selectors:
AGY_MODEL_CONFIG_ID=
# Add HOME/XDG_RUNTIME_DIR/DBUS_SESSION_BUS_ADDRESS only after checking the runtime UID
# and actual Secret Service setup. Copying these alone does not unlock a keyring.
